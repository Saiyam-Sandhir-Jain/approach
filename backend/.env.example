# ── Database ───────────────────────────────────────────────────────────────────
# Local SQLite (default, no setup needed):
DATABASE_URL=sqlite:///./crm.db

# Production PostgreSQL (Supabase):
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# ── Security ───────────────────────────────────────────────────────────────────
# Shared secret between the Next.js frontend and this backend.
# Generate with: openssl rand -base64 32
# Must match BACKEND_API_KEY in the frontend's .env.local
BACKEND_API_KEY=your_shared_secret_here

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash).
ALLOWED_ORIGINS=http://localhost:3000,https://approach-nu.vercel.app
